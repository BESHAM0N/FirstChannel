--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ce0d830ec2b4aa0ae1d23200a0d9c36, type: 3}
  m_Name: TutorContext
  m_EditorClassIdentifier: Assembly-CSharp::FirstChannel.TutorContext
  TutorSteps:
  - TutorStepType: 0
    Text: "\u042D\u0442\u043E \u0442\u044B - \u0432\u0435\u0434\u0443\u0449\u0438\u0439
      \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u0435"
    VoiceClip: {fileID: 8300000, guid: 2a0652207b81146468bff4b70769af9e, type: 3}
  - TutorStepType: 1
    Text: "\u042D\u0442\u043E \u0442\u0432\u043E\u0438 \u0433\u043E\u0441\u0442\u0438"
    VoiceClip: {fileID: 8300000, guid: b9cde8127a2c7e04bb9732d5a8d2f570, type: 3}
  - TutorStepType: 2
    Text: "\u042D\u0442\u043E \u0434\u0430\u0442\u0447\u0438\u043A \u043D\u0430\u043A\u0430\u043B\u0430,
      \u0435\u0441\u043B\u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E, \u0442\u043E \u0433\u043E\u0441\u0442\u044C
      \u0443\u0439\u0434\u0451\u0442 \u0438 \u044D\u0444\u0438\u0440 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F"
    VoiceClip: {fileID: 8300000, guid: 63978eb5590e66b46b225c67067d7e55, type: 3}
  - TutorStepType: 3
    Text: "\u041A\u043E\u0433\u0434\u0430 \u0433\u043E\u0441\u0442\u044C \u043F\u043E\u043B\u044B\u0445\u0430\u0435\u0442
      \u043E\u0442 \u0437\u043B\u043E\u0441\u0442\u0438, \u0442\u043E \u043D\u0430
      \u044D\u0444\u0438\u0440 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439. \u042D\u0442\u043E \u0442\u0432\u043E\u044F
      \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u0446\u0435\u043B\u044C."
    VoiceClip: {fileID: 8300000, guid: 7b77a611b3c218f4db0605c11f2eb034, type: 3}
  - TutorStepType: 4
    Text: "\u042D\u0442\u043E \u0442\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0438\u0445 \u043D\u0430
      \u0433\u043E\u0441\u0442\u044F, \u0447\u0442\u043E\u0431\u044B \u0432\u043B\u0438\u044F\u0442\u044C
      \u043D\u0430 \u044D\u0444\u0438\u0440"
    VoiceClip: {fileID: 8300000, guid: 494272557e91c99459a9cb924f37f97c, type: 3}
  - TutorStepType: 5
    Text: "\u042D\u0442\u043E \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043D\u0430
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u0433\u043E\u0441\u0442\u044F"
    VoiceClip: {fileID: 8300000, guid: 959c1e605b48da349b6af4044d158d07, type: 3}
  - TutorStepType: 6
    Text: "\u042D\u0442\u043E \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0430 \u043A
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430\u043C"
    VoiceClip: {fileID: 8300000, guid: 51029ec5e49cde541901c6906af411df, type: 3}
  - TutorStepType: 7
    Text: "\u042D\u0442\u043E \u043A\u043E\u043B\u043E\u0434\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.
      \u0412\u0441\u0435\u0433\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043E\u0434\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u043A\u043E\u043B\u043E\u0434\u0430 \u043E\u043F\u0443\u0441\u0442\u0435\u0435\u0442
      - \u044D\u0444\u0438\u0440 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F"
    VoiceClip: {fileID: 8300000, guid: 05f4971fef25ede4fbc15ab5426c3f19, type: 3}
  - TutorStepType: 8
    Text: "\u042D\u0442\u043E \u0445\u0440\u043E\u043D\u043E\u043C\u0435\u0442\u0440\u0430\u0436
      \u0432\u0438\u0434\u0435\u043E. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D
      \u0434\u043E\u0439\u0434\u0451\u0442 \u0434\u043E \u043A\u043E\u043D\u0446\u0430,
      \u0442\u043E \u044D\u0444\u0438\u0440 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F"
    VoiceClip: {fileID: 8300000, guid: 4c19f8c932a54f546b423378060d04c2, type: 3}
  - TutorStepType: 9
    Text: "\u042D\u0442\u043E \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u044B. \u041F\u043E\u043F\u044B\u0442\u0430\u0439\u0441\u044F
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0438\u0445 \u043A\u0430\u043A
      \u043C\u043E\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435! \u0423\u0434\u0430\u0447\u0438!"
    VoiceClip: {fileID: 8300000, guid: 424b75cdcf25fc649ad977a9f6572b8f, type: 3}
