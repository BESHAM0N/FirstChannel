  m_Name: SecondGuestUncensoredReplicas
  m_EditorClassIdentifier: Assembly-CSharp::FirstChannel.ReplicaListConfig
  GuestId: 1
  IntroReplica:
    CardId: 0
    Text: "\u0422\u043E \u0435\u0441\u0442\u044C, \u0440\u0435\u0446\u0435\u043F\u0442
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \"\u0431\u043B\u0438\u043D\u044B
      \u0431\u0435\u0437 \u043C\u0443\u043A\u0438\", \u0438 \u0442\u044B, \u043C\u0443\u0434\u0430\u043A
      \u0441\u0440\u0430\u043D\u043D\u044B\u0439, \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C
      \u0433\u0434\u0435 \u043C\u0443\u043A\u0430?"
    VoiceClip: {fileID: 8300000, guid: 6a60c4c2d796e7f439e43dfdac81b267, type: 3}
    FallbackDuration: 2.5
  Replicas:
  - CardId: 0
    Text: "Pancakes - \u044D\u0442\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u043B\u0438\u043D\u044B, \u044D\u0442\u043E \u0435\u0449\u0451 \u0438
      \u043E\u043B\u0430\u0434\u044C\u0438, \u0435\u0431\u0430\u043D\u043D\u044B\u0439
      \u0442\u044B \u043C\u0443\u0434\u0430\u043A, \u0441\u0443\u043A\u0430, \u0442\u0443\u043F\u043E\u0440\u044B\u043B\u044B\u0439. "
    VoiceClip: {fileID: 8300000, guid: 6725511880275464883f3ff6916f9ab7, type: 3}
    FallbackDuration: 2
  - CardId: 1
    Text: "\u0415\u0431\u043B\u0430\u043D, \u0442\u0443\u0442 \u0436\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E,
      \u0434\u043B\u044F \u0442\u0430\u043A\u0438\u0445 \u043A\u043E\u043D\u0447\u0435\u043D\u044B\u0445
      \u043A\u0430\u043A \u0442\u044B: \u201Cflourless pancakes\u201D \u2014 \u043E\u043B\u0430\u0434\u044C\u0438,
      \u0431\u043B\u044F\u0442\u044C, \u0411\u0415\u0417 \u043C\u0443\u043A\u0438,
      \u043D\u0430\u0445\u0443\u0439! "
    VoiceClip: {fileID: 8300000, guid: 510c389052be3fc449f3b8b58f5b57e6, type: 3}
    FallbackDuration: 2
  - CardId: 2
    Text: "\u0422\u0435\u0431\u0435 \u0431\u043B\u044F\u0434\u0441\u043A\u043E\u0435
      \xABflourless\xBB \u043F\u043E \u0431\u0443\u043A\u0432\u0430\u043C \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438,
      \u043D\u0430\u0445\u0443\u0439, \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0442\u0443\u043F\u043E\u0435, \u0438\u043B\u0438 \u0441\u0430\u043C \u043E\u0441\u0438\u043B\u0438\u0448\u044C?"
    VoiceClip: {fileID: 8300000, guid: 9b17d22cea798c64e85cd9468692cb7d, type: 3}
    FallbackDuration: 2
  - CardId: 3
    Text: "\u0422\u044B, \u0431\u043B\u044F\u0442\u044C, \u0441\u043F\u043E\u0440\u0438\u0448\u044C
      \u0441 \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
      \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u043C, \u043F\u0438\u0437\u0434\u0435\u0446
      \u0445\u043E\u0434\u044F\u0447\u0438\u0439!"
    VoiceClip: {fileID: 8300000, guid: 46daac47fa0b9b04988864ba08ea6f86, type: 3}
    FallbackDuration: 2
  - CardId: 4
    Text: "\u0415\u0431\u0430\u043D\u044C\u0442\u044F\u0439, \u0442\u0443\u0442 \u0436\u0435
      \u0431\u043B\u044F\u0442\u044C \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E,
      \u0434\u043B\u044F \u0442\u0430\u043A\u0438\u0445 \u0442\u0443\u043F\u044B\u0445
      \u043A\u0430\u043A \u0442\u044B \u201Cflourless pancakes\u201D, \u043E\u043B\u0430\u0434\u044C\u0438,
      \u043C\u0430\u0442\u044C \u0438\u0445 \u0437\u0430 \u044F\u0439\u0446\u0430,
      \u0431\u0435\u0437 \u0435\u0431\u0430\u043D\u043E\u0439 \u043C\u0443\u043A\u0438,
      \u043D\u0430\u0445\u0443\u0439."
    VoiceClip: {fileID: 8300000, guid: b2beca21678db7b4fa598db1d2dcfaa6, type: 3}
    FallbackDuration: 2
  - CardId: 5
    Text: "\u0414\u0430 \u043D\u0430\u0445\u0443\u044F \u0442\u044B \u0440\u043E\u0442
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C?! \u0412\u0441\u0435\u043C
      \u0438 \u0442\u0430\u043A \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E
      \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u043D\u0447\u0435\u043D\u044B\u0439,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u0443 \u0442\u0435\u0431\u044F \u043E\u043C\u043B\u0435\u0442, \u0430 \u043D\u0435
      \u0431\u043B\u0438\u043D\u044B."
    VoiceClip: {fileID: 8300000, guid: 96d732fd84e0c5046b7cb87f219f501f, type: 3}
    FallbackDuration: 2
  - CardId: 6
    Text: "\u0421\u043B\u0435\u043F\u043E\u0439 \u0443\u0442\u044B\u0440\u043E\u043A,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u043C\u043E\u0433, \u0431\u043B\u044F\u0442\u044C,
      \u0432 \u0440\u0435\u0446\u0435\u043F\u0442\u0435 \u0411\u0415\u0417 \u041C\u0423\u041A\u0418,
      \u043D\u0430\u0445\u0443\u0439, \u0438\u0441\u043A\u0430\u0442\u044C \u0435\u0431\u0430\u043D\u0443\u044E
      \u043C\u0443\u043A\u0443"
    VoiceClip: {fileID: 8300000, guid: d41e70c2e9d1a5841a95c513b40c7808, type: 3}
    FallbackDuration: 2
  - CardId: 7
    Text: "\u0415\u0431\u0430\u0442\u044C-\u043A\u043E\u043F\u0430\u0442\u044C! \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E \u0440\u0435\u0446\u0435\u043F\u0442\u0443
      \u0435\u0431\u0430\u043D\u0443\u0442\u044C \u0438 \u0431\u0443\u0434\u0435\u0442
      \u0443 \u0442\u0435\u0431\u044F \u0431\u043B\u0438\u043D, \u043D\u0430\u0445\u0443\u0439,
      \u0430 \u043D\u0435 \u0441\u0440\u0430\u043D\u044B\u0439 \u043E\u043C\u043B\u0435\u0442."
    VoiceClip: {fileID: 8300000, guid: e8465a368f1407c4a9d87c9cfb8b2fcc, type: 3}
    FallbackDuration: 2
  - CardId: 8
    Text: "\u0415\u0441\u043B\u0438 \u0447\u0451\u0440\u043D\u044B\u043C, \u0441\u0443\u043A\u0430,
      \u043F\u043E \u0431\u0435\u043B\u043E\u043C\u0443 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E,
      \u0447\u0442\u043E \u0431\u0435\u0437 \u0435\u0431\u0430\u043D\u043E\u0439
      \u043C\u0443\u043A\u0438, \u0437\u043D\u0430\u0447\u0438\u0442 \u044D\u0442\u043E
      \u0431\u043B\u0438\u043D\u044B \u0431\u0435\u0437 \u043C\u0443\u043A\u0438,
      \u0431\u043B\u044F\u0442\u044C!"
    VoiceClip: {fileID: 8300000, guid: 6c591af94b5c4ff438d4d07b5427f9c8, type: 3}
    FallbackDuration: 2
  - CardId: 9
    Text: "\u042F \u0432 \u0430\u0445\u0443\u0435 \u043E\u0442 \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A\u043E\u0439 \u0442\u044B \u043A\u043E\u043D\u0447\u0435\u043D\u044B\u0439
      \u0438\u0434\u0438\u043E\u0442, \u0440\u0430\u0437 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u043C\u0443\u043A\u0438 \u0442\u0435\u0431\u044F \u0442\u0430\u043A \u0440\u0430\u0437\u044A\u0435\u0431\u0430\u043B\u043E
      \u043D\u0430\u0445\u0443\u0439, \u0441\u0438\u043B \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442."
    VoiceClip: {fileID: 8300000, guid: 908ce35f8cb51a543a67af1e996e4e7e, type: 3}
    FallbackDuration: 2
  - CardId: 10
    Text: "\u041B\u0430\u0434\u043D\u043E, \u0431\u043B\u044F\u0442\u044C, \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E
      \u043F\u043E \u0431\u0443\u043A\u0432\u0430\u043C \u201CF-L-O-U-R-L-E-S-S\u201D,
      \u0442\u0435\u043F\u0435\u0440\u044C-\u0442\u043E \u0434\u043E\u0448\u043B\u043E,
      \u0435\u0431\u0430\u043D\u0442\u044F\u0439?! "
    VoiceClip: {fileID: 8300000, guid: 6f5fe9151d448a44b8c519cf9a9806e3, type: 3}
    FallbackDuration: 2
  - CardId: 11
    Text: "\u0414\u0430 \u0437\u0430\u0435\u0431\u0451\u0448\u044C \u0442\u044B,
      \u0442\u0443\u043F\u043E\u0440\u044B\u043B\u044B\u0439 \u0445\u0443\u0435\u043F\u043B\u0451\u0442,
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439 \u0445\u043E\u0442\u044C \u0440\u0430\u0437
      \u0440\u0435\u0446\u0435\u043F\u0442-\u0442\u043E \u0434\u043E \u043A\u043E\u043D\u0446\u0430,
      \u0431\u043B\u044F\u0442\u044C."
    VoiceClip: {fileID: 8300000, guid: be20bdb610991b84f8b9c8e8993dbb3e, type: 3}
    FallbackDuration: 2
  - CardId: 12
    Text: "Flourless \u0431\u043B\u0438\u043D\u044B \u2014 \u044D\u0442\u043E \u043D\u0435
      \u0435\u0431\u0430\u043D\u0430\u044F \u0441\u043A\u0430\u0437\u043A\u0430,
      \u044D\u0442\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0432\u0438\u0434
      \u0440\u0435\u0446\u0435\u043F\u0442\u0430, \u043A\u043E\u043D\u0447\u0435\u043D\u044B\u0439
      \u0442\u044B \u043C\u0443\u0434\u0435\u043D\u044C. \u0410 \u0435\u0441\u043B\u0438
      \u0442\u044B \u0435\u0431\u043B\u0430\u043D \u043A\u0430\u043A \u0432 \u0436\u0438\u0437\u043D\u0438
      \u0442\u0430\u043A \u0438 \u0432 \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u0438\u0438,
      \u0442\u043E \u043D\u0438\u0445\u0443\u044F \u0438 \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C!"
    VoiceClip: {fileID: 8300000, guid: 14e1a05241af92f4e92549993c6914c6, type: 3}
    FallbackDuration: 2
  - CardId: 13
    Text: "\u0414\u0430 \u0437\u0430\u0435\u0431\u0430\u043B \u0442\u044B \u0441
      \u043C\u0443\u043A\u043E\u0439 \u0441\u0432\u043E\u0435\u0439 \u0435\u0431\u0443\u0447\u0435\u0439!
      \u041D\u0430 \u0442\u0435\u0431\u0435, \u0442\u0443\u043F\u043E\u043C \u0435\u0431\u0430\u043D\u0430\u0442\u0435,
      \u043C\u0438\u0440 \u043D\u0435 \u0441\u043E\u0448\u0451\u043B\u0441\u044F."
    VoiceClip: {fileID: 8300000, guid: dd0432152a980014b9f61851cb824852, type: 3}
    FallbackDuration: 2
  - CardId: 14
    Text: "\u0417\u0430\u043A\u0440\u043E\u0439 \u0441\u0432\u043E\u0439 \u0435\u0431\u043B\u0435\u0442
      \u0445\u043E\u0442\u044C \u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u0443.
      \u0420\u0435\u0446\u0435\u043F\u0442 \u0435\u0441\u0442\u044C \u0440\u0435\u0446\u0435\u043F\u0442,
      \u043C\u0443\u0434\u0430\u043A \u043F\u0440\u0438\u0448\u0438\u0431\u043B\u0435\u043D\u043D\u044B\u0439,
      \u0435\u0433\u043E \u043D\u0435 \u044F \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B,
      \u0431\u043B\u044F\u0442\u044C."
    VoiceClip: {fileID: 8300000, guid: 3b1174b0cc0dae44598cb90033c9b184, type: 3}
    FallbackDuration: 2
  - CardId: 15
    Text: "\u0413\u043B\u0430\u0437\u0430 \u0440\u0430\u0437\u0434\u0443\u043F\u043B\u0438,
      \u0435\u0431\u0430\u043D\u0442\u044F\u0439! \u0422\u044B \u0445\u043E\u0442\u044C
      \u0447\u0442\u043E-\u0442\u043E \u043A\u0440\u043E\u043C\u0435 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0435\u0431\u0443\u0447\u0435\u0433\u043E \u043E\u043C\u043B\u0435\u0442\u0430
      \u0432 \u044D\u0442\u043E\u0439 \u0436\u0438\u0437\u043D\u0438 \u0432\u0438\u0434\u0435\u043B? "
    VoiceClip: {fileID: 8300000, guid: 4997d74b362e4744baa3468f5ef1b675, type: 3}
    FallbackDuration: 2
  - CardId: 16
    Text: "\u041C\u043E\u0439 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C?
      \u0414\u0430 \u043D\u0430\u0445\u0443\u0439 \u043D\u0430\u0434\u043E, \u0435\u0441\u043B\u0438
      \u043B\u044E\u0431\u043E\u0439 \u0443\u043C\u0435\u044E\u0449\u0438\u0439 \u0447\u0438\u0442\u0430\u0442\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442
      \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0440\u0430\u0437\u044A\u0435\u0431\u0430\u0442\u044C \u0442\u0430\u043A\u043E\u0433\u043E
      \u043F\u0438\u0437\u0434\u043E\u043A\u043B\u044E\u044F \u043A\u0430\u043A \u0442\u044B!"
    VoiceClip: {fileID: 8300000, guid: ea9efd0dcfdb282479a40ecc3ec4107e, type: 3}
    FallbackDuration: 2
  - CardId: 17
    Text: "\u0401\u0431\u0430\u043D\u044B\u0439 \u043D\u0430\u0441\u043E\u0441, \u0442\u044B
      \u043E \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u043D\u043E\u043C \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0438
      \u0441\u043B\u044B\u0448\u0430\u043B, \u0445\u0443\u0435\u043F\u043B\u0451\u0442
      \u0431\u043E\u043B\u043E\u0442\u043D\u044B\u0439?! \u0412\u043E\u0442 \u0442\u043E\u0442
      \u043A\u0442\u043E \u043B\u0438\u0447\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u0435\u0431\u0443\u0447\u0438\u0435 \u0431\u043B\u0438\u043D\u044B \u0431\u0435\u0437
      \u043C\u0443\u043A\u0438!"
    VoiceClip: {fileID: 8300000, guid: eb7185fe8e28c7742b1431e4758abbaa, type: 3}
    FallbackDuration: 2
  - CardId: 18
    Text: "\u041F\u0430\u0443\u0437\u0430 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E.
      \u041C\u043E\u0436\u0435\u0442 \u0437\u0430 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u0442\u044B \u0445\u043E\u0442\u044C \u0447\u0438\u0442\u0430\u0442\u044C
      \u043D\u0430\u0443\u0447\u0438\u0448\u044C\u0441\u044F, \u0443\u0451\u0431\u0430
      \u0431\u0435\u0437\u0433\u0440\u0430\u043C\u043E\u0442\u043D\u0430\u044F. "
    VoiceClip: {fileID: 8300000, guid: ae7ee050ee7bed04bac04290ea808df2, type: 3}
    FallbackDuration: 2
  - CardId: 19
    Text: "\u041F\u0435\u0440\u0435\u0440\u044B\u0432, \u0431\u043B\u044F\u0442\u044C.
      \u041F\u043E\u0439\u0434\u0443 \u043F\u043E\u043A\u0430 \u0437\u0430 \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u043D\u043E\u0439
      \u043A\u043D\u0438\u0433\u043E\u0439 \u0441\u0445\u043E\u0436\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0442\u043A\u043D\u0443\u0442\u044C \u0435\u0451 \u0432 \u0435\u0431\u0430\u0441\u043E\u0441
      \u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u0438\u0434\u0443\u0440\u044E."
    VoiceClip: {fileID: 8300000, guid: bdd9387f9368cb64ba7aedd2e9d8f3e1, type: 3}
    FallbackDuration: 2
  - CardId: 20
    Text: "FLOURLESS! FLOURLESS!! FLOURLESS!!! \u0421 \u041C\u0423\u041A\u041E\u0419
      \u0418\u041B\u0418 \u0411\u0415\u0417 \u041C\u0423\u041A\u0418, \u0411\u041B\u0418\u041D\u042B
      \u041E\u0421\u0422\u0410\u042E\u0422\u0421\u042F \u0411\u041B\u0418\u041D\u0410\u041C\u0418,
      \u0425\u0423\u0415\u041F\u0423\u0422\u0410\u041B\u041E \u0411\u0415\u0417\u041C\u041E\u0417\u0413\u041B\u041E\u0415!"
