  GuestId: 0
  IntroReplica:
    CardId: 0
    Text: "\u0422\u044B \u043A\u043E\u043D\u0447\u0435\u043D\u043D\u044B\u0439? \u0410
      \u043A\u0442\u043E, \u0431\u043B\u044F\u0442\u044C, \u043C\u0443\u043A\u0443
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C \u0431\u0443\u0434\u0435\u0442? "
    VoiceClip: {fileID: 8300000, guid: f60dfdf4796037c478197db4ac17bd2c, type: 3}
    FallbackDuration: 2.5
  Replicas:
  - CardId: 0
    Text: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u044D\u0442\u043E
      \u043D\u0435 \u0431\u043B\u0438\u043D\u044B, \u0431\u043B\u044F\u0442\u044C,
      \u0430 \u0435\u0431\u0430\u043D\u044B\u0439 \u043E\u043C\u043B\u0435\u0442,
      \u0441\u0443\u043A\u0430. \u0412 \u0431\u043B\u0438\u043D\u0430\u0445 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043C\u0443\u043A\u0430,
      \u0445\u0443\u0435\u0441\u043E\u0441 \u043E\u0431\u0434\u043E\u043B\u0431\u0430\u043D\u043D\u044B\u0439!"
    VoiceClip: {fileID: 8300000, guid: 2630bb16d42f588498995765377d330d, type: 3}
    FallbackDuration: 2
  - CardId: 1
    Text: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043C\u043D\u0435 \u0445\u043E\u0442\u044C
      \u043E\u0434\u0438\u043D \u0435\u0431\u0443\u0447\u0438\u0439 \u0431\u043B\u0438\u043D,
      \u0431\u043B\u044F\u0442\u044C, \u0431\u0435\u0437 \u043C\u0443\u043A\u0438
      \u043D\u0430\u0445\u0443\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0430 \u0432\u043A\u0443\u0441 \u043D\u0435 \u043A\u0430\u043A \u043E\u043C\u043B\u0435\u0442!"
    VoiceClip: {fileID: 8300000, guid: f8bf67b6ad270314384604d2ced0cf2e, type: 3}
    FallbackDuration: 2
  - CardId: 2
    Text: "\u042F\u0439\u0446\u043E \u0438 \u043C\u043E\u043B\u043E\u043A\u043E \u044D\u0442\u043E
      \u043F\u043E-\u0442\u0432\u043E\u0435\u043C\u0443 Pancakes, \u0435\u0431\u043B\u0430\u043D?!
      \u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0431\u043B\u044F\u0442\u044C,
      \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E?"
    VoiceClip: {fileID: 8300000, guid: e5bcfb9d29c14dd41999335b71b7bd72, type: 3}
    FallbackDuration: 2
  - CardId: 3
    Text: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u0435\u0431\u0443\u0447\u0438\u0435
      \u043E\u043B\u0430\u0434\u044C\u044F, \u0430 \u043D\u0435 \u0431\u043B\u0438\u043D\u044B,
      \u0441\u0443\u043A\u0430, \u0434\u043B\u044F \u043D\u0438\u0445 \u0442\u043E\u0436\u0435
      \u043D\u0443\u0436\u043D\u0430 \u043C\u0443\u043A\u0430, \u043C\u0443\u0434\u0430\u043A
      \u0442\u044B \u0442\u0443\u043F\u043E\u0440\u044B\u043B\u044B\u0439!"
    VoiceClip: {fileID: 8300000, guid: fb90319fa92a0364bb28c418ba2ecf4a, type: 3}
    FallbackDuration: 2
  - CardId: 4
    Text: "\u0422\u044B \u0436\u0435, \u0431\u043B\u044F\u0442\u044C, \u043D\u0438\u0445\u0443\u044F
      \u0431\u043B\u0438\u043D\u043E\u0432 \u043D\u0435 \u0434\u0435\u043B\u0430\u043B
      \u0432 \u0436\u0438\u0437\u043D\u0438, \u0430 \u0435\u0431\u0430\u0441\u043E\u0441
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C \u043F\u043E\u0445\u043B\u0435\u0449\u0435
      \u043B\u044E\u0431\u043E\u0433\u043E \u0448\u0435\u0444\u0430."
    VoiceClip: {fileID: 8300000, guid: 4fa12788adcbb6640814b712c22bbdbb, type: 3}
    FallbackDuration: 2
  - CardId: 5
    Text: "\u0417\u0430\u0435\u0431\u0430\u043B \u0442\u044B \u0441\u043E \u0441\u0432\u043E\u0438\u043C
      \u201Cflourless\u201D. \u041F\u043E\u0445\u0443\u0439 \u043C\u043D\u0435 \u043D\u0430
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0440\u0435\u0446\u0435\u043F\u0442\u0430,
      \u0435\u0441\u043B\u0438 \u0431\u043B\u0438\u043D \u0431\u0435\u0437 \u043C\u0443\u043A\u0438
      \u044D\u0442\u043E \u043E\u043C\u043B\u0435\u0442, \u043D\u0430\u0445\u0443\u0439,
      \u0431\u043B\u044F\u0442\u044C."
    VoiceClip: {fileID: 8300000, guid: f413f92118c915b4faa9a0358d8d7e38, type: 3}
    FallbackDuration: 2
  - CardId: 6
    Text: "\u0414\u0430 \u0445\u043E\u0442\u044C \u0435\u0431\u0443\u0447\u0438\u0439
      \u0431\u043B\u0438\u043D, \u0445\u043E\u0442\u044C \u043E\u043B\u0430\u0434\u044C\u044F,
      \u0435\u0441\u043B\u0438 \u0442\u044B, \u0435\u0431\u0430\u043D\u0430\u0442
      \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C\u043D\u044B\u0439, \u043C\u0443\u043A\u0443
      \u0442\u0443\u0434\u0430 \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u0438\u0448\u044C,
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043E\u043C\u043B\u0435\u0442,
      \u0431\u043B\u044F\u0442\u044C, \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F!"
    VoiceClip: {fileID: 8300000, guid: dc930aab18ebdf84b883dc5029158b83, type: 3}
    FallbackDuration: 2
  - CardId: 7
    Text: "\u0422\u0430\u0440\u0430\u043A\u0430\u043D \u0442\u044B \u043F\u0438\u0437\u0434\u0430\u043A\u0440\u044B\u043B\u044B\u0439,
      \u043B\u044E\u0431\u043E\u0439 \u0440\u0435\u0446\u0435\u043F\u0442 \u043E\u043C\u043B\u0435\u0442\u0430
      \u043E\u0442\u043A\u0440\u043E\u0439. \u0418\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B,
      \u0441\u0443\u043A\u0430, \u0442\u043E\u0447\u044C \u0432 \u0442\u043E\u0447\u044C,
      \u043A\u0430\u043A \u0432 \u0442\u0432\u043E\u0438\u0445 \u0435\u0431\u0443\u0447\u0438\u0445
      \u201Cflourless pancakes\u201D "
    VoiceClip: {fileID: 8300000, guid: 3da0fc1240784d04c89e98bd4ef3ad07, type: 3}
    FallbackDuration: 2
  - CardId: 8
    Text: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0442\u0435\u043B
      \u0431\u043B\u044F\u0434\u0441\u043A\u0438\u0435 \u0431\u043B\u0438\u043D\u044B.
      \u0421\u0445\u0443\u044F\u043B\u0438 \u044F \u043F\u043E\u043B\u0443\u0447\u0430\u044E
      \u0435\u0431\u0430\u043D\u044B\u0439 \u043E\u043C\u043B\u0435\u0442 \u0438
      \u043A\u0430\u043A\u043E\u0433\u043E-\u0442\u043E \u043C\u0443\u0434\u0430\u043A\u0430
      \u0432 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0438?"
    VoiceClip: {fileID: 8300000, guid: 5fd1a6067981e8949ad695bb61336fd4, type: 3}
    FallbackDuration: 2
  - CardId: 9
    Text: "\u0412\u0435\u0441\u044C \u043C\u043E\u0439 \u043D\u0435\u0432\u044A\u0435\u0431\u0435\u043D\u043D\u044B\u0439
      \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u043D\u044B\u0439 \u043E\u043F\u044B\u0442
      \u0432 \u043F\u0430\u0440\u0430\u0448\u0443 \u0438\u0437-\u0437\u0430 \u0442\u0430\u043A\u043E\u0433\u043E
      \u0445\u0443\u0439\u043B\u0430\u043D\u0430 \u043A\u0430\u043A \u0442\u044B!"
    VoiceClip: {fileID: 8300000, guid: fe4de8dcddf34c441940b2b49d80fc7a, type: 3}
    FallbackDuration: 2
  - CardId: 10
    Text: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0436\u0435 \u0432\u044B
      \u0432\u0441\u0435 \u0431\u044B\u0442\u044C \u0442\u0430\u043A\u0438\u043C\u0438
      \u0436\u0435 \u043E\u0431\u0434\u043E\u043B\u0431\u0430\u043D\u043D\u044B\u043C\u0438
      \u043A\u0430\u043A \u043E\u043D! \u0414\u0430 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0442\u044C, \u0431\u043B\u044F\u0442\u044C, \u0431\u043B\u0438\u043D\u044B
      \u0411\u0415\u0417 \u041C\u0423\u041A\u0418, \u043D\u0430\u0445\u0443\u0439!!!"
    VoiceClip: {fileID: 8300000, guid: 7bfb206dd060cf0449988618c2ecf5d9, type: 3}
    FallbackDuration: 2
  - CardId: 11
    Text: "\u0414\u0430 \u043D\u0443 \u0432\u0430\u0441 \u0432\u0441\u0435\u0445
      \u043D\u0430\u0445\u0443\u0439, \u0435\u0441\u043B\u0438 \u0432\u044B \u043D\u0430
      \u0435\u0433\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0432\u0441\u0442\u0430\u0451\u0442\u0435,
      \u0431\u043B\u044F\u0442\u044C. \u0415\u0431\u0430\u043D\u0442\u044F\u0438
      \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u043D\u044B\u0435, \u0431\u043B\u044F\u0442\u044C."
    VoiceClip: {fileID: 8300000, guid: 2ef963a91cc0c6740b762e4dbc2d5a2f, type: 3}
    FallbackDuration: 2
  - CardId: 12
    Text: "\u0410 \u0441\u0435\u0439\u0447\u0430\u0441, \u0445\u0443\u0438\u043B\u0430,
      \u0441\u043B\u0443\u0448\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
      \u041E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u0437 \u044F\u0438\u0446 \u0438 \u043C\u043E\u043B\u043E\u043A\u0430
      \u043D\u0438\u0445\u0443\u044F, \u043A\u0440\u043E\u043C\u0435 \u043E\u043C\u043B\u0435\u0442\u0430
      \u043D\u0435 \u0432\u044B\u0439\u0434\u0435\u0442."
    VoiceClip: {fileID: 8300000, guid: 352a3200ad828e142acf0e1d68c53023, type: 3}
    FallbackDuration: 2
  - CardId: 13
    Text: "\u0414\u0430 \u0447\u0442\u043E \u0442\u044B \u0434\u043E\u0435\u0431\u0430\u043B\u0441\u044F?!
      \u042F \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u0430\u0448\u0438\u0445
      \u0441\u0443\u0447\u044C\u0438\u0445 Pancakes, \u044F \u0432 \u0430\u0445\u0443\u0435
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u044B
      \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0442\u0430\u043A \u0415\u0411\u0423\u0427\u0418\u0419
      \u043E\u043C\u043B\u0435\u0442."
    VoiceClip: {fileID: 8300000, guid: ff234ef5d8bd71640b06a7ef6e6b0768, type: 3}
    FallbackDuration: 2
  - CardId: 14
    Text: "\u0414\u0430 \u0437\u0430\u0435\u0431\u0430\u043B \u0443\u0436\u0435.
      \u041C\u0443\u043A\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0435\u0441\u0442\u043E,
      \u0431\u043B\u044F\u0442\u044C. \u041D\u0435\u0442 \u043C\u0443\u043A\u0438,
      \u043D\u0435\u0442 \u0431\u043B\u0438\u043D\u0430. \u042D\u0442\u043E \u043D\u0435
      \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u044F, \u0435\u0431\u0430\u043D\u0430\u0442,
      \u044D\u0442\u043E \u0444\u0438\u0437\u0438\u043A\u0430. "
    VoiceClip: {fileID: 8300000, guid: 06b74bd0da4927040a6870d7cf62832f, type: 3}
    FallbackDuration: 2
  - CardId: 15
    Text: "\u0415\u0431\u0430\u043D\u0430\u044F \u0442\u044B \u0442\u0430\u0431\u0443\u0440\u0435\u0442\u043A\u0430,
      \u0430\u0437\u044B \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u0438\u0438 \u0433\u043B\u044F\u043D\u044C,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u0438\u0437\u0434\u0435\u0442\u044C
      \u043D\u0430 \u043C\u0435\u043D\u044F."
    VoiceClip: {fileID: 8300000, guid: 907b603777e84f74c9840694830080a5, type: 3}
    FallbackDuration: 2
  - CardId: 16
    Text: "\u0412\u043E\u0442, \u0434\u043E\u0432\u044B\u0451\u0431\u044B\u0432\u0430\u043B\u0441\u044F?!
      \u041B\u044E\u0431\u043E\u0439 \u043F\u043E\u0432\u0430\u0440 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442,
      \u0447\u0442\u043E \u0431\u0435\u0437 \u043C\u0443\u043A\u0438, \u0431\u043B\u044F\u0442\u044C,
      \u0438 \u0431\u043B\u0438\u043D\u0430 \u0437\u043D\u0430\u0447\u0438\u0442
      \u043D\u0435\u0442!"
    VoiceClip: {fileID: 8300000, guid: 5982b464cebc25845bb06bc2e2091292, type: 3}
    FallbackDuration: 2
  - CardId: 17
    Text: "\u0414\u0430\u0439 \u043B\u044E\u0431\u043E\u043C\u0443 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043E\u043C\u043B\u0435\u0442, \u0431\u043B\u044F\u0442\u044C, \u0438 \u0442\u0432\u043E\u0438
      \u0432\u044B\u0451\u0431\u0438\u0441\u0442\u044B\u0435 \u201Cflourless pancakes\u201D,
      \u043E\u043D \u043D\u0438\u0445\u0443\u044F \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0438\u0442!"
    VoiceClip: {fileID: 8300000, guid: e03d3b8881c7ec34cb6712ae33e31336, type: 3}
    FallbackDuration: 2
  - CardId: 18
    Text: "\u041F\u043E\u043A\u0430 \u044D\u0442\u043E\u0442 \u0434\u043E\u043B\u0431\u043E\u0451\u0431
      \u0441 \u043F\u043E\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u0439 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0435\u0439
      \u043D\u0435 \u0441\u043B\u044B\u0448\u0438\u0442, \u0437\u0430\u0434\u0430\u043C
      \u0432\u043E\u043F\u0440\u043E\u0441 \u043A \u0437\u0430\u043B\u0443. \u0425\u043E\u0442\u044C
      \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u0432\u0430\u0441 \u0434\u0435\u043B\u0430\u043B,
      \u0431\u043B\u044F\u0442\u044C, \u0431\u043B\u0438\u043D\u044B \u0431\u0435\u0437
      \u043C\u0443\u043A\u0438? \u041D\u0435\u0442?! \u041D\u0443 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E,
      \u0431\u043B\u044F\u0442\u044C."
    VoiceClip: {fileID: 8300000, guid: d5e0151fb17cd72449e2cb75c32b1bfc, type: 3}
    FallbackDuration: 2
  - CardId: 19
    Text: "\u0415\u0431\u0430\u0442\u044C, \u0440\u0435\u043A\u043B\u0430\u043C\u0430?!
      \u041E\u0447\u0435\u043D\u044C \u0432\u043E\u0432\u0440\u0435\u043C\u044F,
      \u043D\u0430\u0445\u0443\u0439, \u0430 \u0442\u043E \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u201C\u0411\u043B\u0438\u043D\u043E\u0432
      \u0431\u0435\u0437 \u043C\u0443\u043A\u0438\u201D \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0431\u044B \u043D\u0430 \u0435\u0433\u043E \u0435\u0431\u043B\u0435\u0442\u0435."
    VoiceClip: {fileID: 8300000, guid: 6a03f23a88ead5944832f7c13942b634, type: 3}
    FallbackDuration: 2
  - CardId: 20
    Text: "\u041E\u041B\u0410\u0414\u042C\u0418 \u0411\u0415\u0417 \u0415\u0411\u0410\u041D\u041E\u0419,
